.DS_Store

# Build output and dependencies
**/node_modules/
**/dist/
**/target/
*.log
hs_err_pid*.log
replay_pid*.log

# Local and production environment files
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/application-dev.yml
**/application-prod.yml

# Deployment configuration
/deploy/
**/docker-compose.yml
**/Dockerfile

# Certificates, keys, archives, and deployment bundles
**/ssl/
*.key
*.pem
*.p12
*.pfx
*.jks
*.tar
*.tar.gz
*.zip

# Database exports and server-only material
*.sql
!hrm-server/src/test/resources/sql/*.sql
!hrm-server/src/main/resources/db/migration/*.sql
!sql/schema/mysql/
!sql/schema/mysql/*.sql
!sql/schema/postgresql/
!sql/schema/postgresql/*.sql
/sql/migration/
/sql/run_migration.sh
*.rdb

# Local scripts and generated documentation
/scripts/
docs/*
!docs/screenshots/
!docs/screenshots/*.png
# Architecture Decision Records are long-lived assets: they must travel with the repo
!docs/adr/
!docs/adr/*.md

# Uploaded/runtime files
file/
*.xlsx
!examples/import/
!examples/import/*.xlsx

# IDE and agent files
.idea/
.vscode/
.claude/
.codex/
.playwright-mcp/
.tmp_*.txt
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS and tool metadata
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
.apt_generated
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# 临时截图和文档
/*.png
/*.jpg

# 临时文件和重构备份
tmp/
.worktrees/
*.bak

# 本地开发运行时目录
hrm-server/hrm-files/

deploy/
