# Copy this file to .env (same directory) and replace placeholders
# ============================================================
# .env 只放真正敏感/换环境要改的项；本地中间件凭据、端口、运行参数
# 全部字面值写在 application.yml / docker/local/docker-compose.yml
# application.yml 通过 spring.config.import: optional:file:.env 读取本文件
# ============================================================

# LLM（问答 / embedding / rerank / Excel 表头匹配共用；OpenAI 兼容模式）
# 这组环境变量统一由 application.yml 的 llm.* 配置块消费
LLM_API_KEY=<API密钥>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_CHAT_MODEL=qwen3.7-flash
LLM_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 检索重排序模型（RRF 融合后精排；开关见 chat.retrieval.rerank.enabled）
LLM_RERANK_MODEL=qwen3.7-text-rerank

# JWT 签名密钥
JWT_SECRET=REPLACE_WITH_BASE64_JWT_SECRET
