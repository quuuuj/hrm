# Copy this file to .env and replace placeholders
# ============================================================
# 部署地址 / SSH 信息
# ============================================================
SERVER_HOST=<服务器IP>
SERVER_USER=root
REGISTRY_USER=REPLACE_WITH_REGISTRY_USER
REGISTRY_PASSWORD=REPLACE_WITH_REGISTRY_PASSWORD
PUSH_LOG=false

# ============================================================
# MySQL（使用 /opt/app/docker-compose.yml 共享容器，主机名 mysql）
# ============================================================
DB_MASTER_URL=jdbc:mysql://mysql:3306/hrm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
DB_FLOWABLE_URL=jdbc:mysql://mysql:3306/hrm_flowable?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
DB_USERNAME=REPLACE_WITH_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ============================================================
# Redis（使用 /opt/app/docker-compose.yml 共享容器，主机名 redis）
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DATABASE=0

# ============================================================
# PostgreSQL / pgvector（知识库向量存储）
# ============================================================
KB_DB_URL=jdbc:postgresql://hrm-postgres:5432/hrm_kb
KB_DB_USERNAME=REPLACE_WITH_KB_DB_USERNAME
KB_DB_PASSWORD=REPLACE_WITH_KB_DB_PASSWORD

# ============================================================
# MinIO 对象存储
# ============================================================
MINIO_ENDPOINT=http://hrm-minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=hrm

# ============================================================
# JWT
# ============================================================
JWT_SECRET=REPLACE_WITH_BASE64_JWT_SECRET

# ============================================================
# 阿里百炼 DashScope（AI 对话 + 嵌入模型）
# ============================================================
DASHSCOPE_API_KEY=REPLACE_WITH_DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# ============================================================
# 智能问答 / 知识库 功能开关
# ============================================================
CHAT_ENABLED=true
KNOWLEDGE_ENABLED=true

# ============================================================
# LLM 对话提供方（chat.provider）
# ============================================================
LLM_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_PROVIDER_API_KEY=REPLACE_WITH_LLM_PROVIDER_API_KEY
LLM_PROVIDER_MODEL=qwen-plus

# ============================================================
# MyBatis 日志
# ============================================================
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

# ============================================================
# 员工默认密码
# ============================================================
STAFF_DEFAULT_PASSWORD=123
